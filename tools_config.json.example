{
    "bin_path": "./bin",
    "limits": {
        "max_file_bytes": 2147483648,
        "max_resource_bytes": 104857600,
        "max_total_extracted_bytes": 1073741824,
        "max_raw_json_mb": 512,
        "max_summary_items": 10000,
        "max_strings": 1000000,
        "max_ioc_text_mb": 64,
        "max_matches": 1000
    },
    "plugins": {
        "vtlookup": {
            "name": "VirusTotal TI Lookup",
            "enabled": false,
            "api_key_env": "VT_API_KEY",
            "lookup_exact_hash": true,
            "fetch_relations_behaviour": true,
            "relations_result_limit": 40,
            "rate_limit_sleep": 20,
            "cache_ttl_seconds": 86400,
            "lookup_fuzzy_hash": false,
            "fuzzy_lookup_limit": 5
        },
        "malwarebazaar": {
            "name": "MalwareBazaar TI Lookup",
            "enabled": false,
            "api_key_env": "MB_API_KEY",
            "base_url": "https://mb-api.abuse.ch/api/v1/",
            "cache_ttl_seconds": 86400,
            "lookup_exact_hash": true,
            "lookup_fuzzy_hash": true,
            "relation_limit": 10
        },
        "diec": {
            "name": "Detect It Easy Analyzer",
            "enabled": true,
            "tool": "diec",
            "timeout": 300
        },
        "capa": {
            "name": "capa Capability Analyzer",
            "enabled": true,
            "tool": "capa-v10.0.0-linux",
            "timeout": 600
        },
        "fileinfo": {
            "name": "Basic File Information",
            "enabled": true
        },
        "pe_sections": {
            "name": "PE Section Analyzer",
            "enabled": true
        },
        "authenticode": {
            "name": "Authenticode Signature Analyzer",
            "enabled": true
        },
        "elfstructure": {
            "name": "ELF Structure Analyzer",
            "enabled": true
        },
        "resource_overlay": {
            "name": "Resource & Overlay Analyzer",
            "enabled": true,
            "extract_resources": true,
            "extract_overlay": true
        },
        "yara_scanner": {
            "name": "YARA Scanner",
            "enabled": true,
            "rule_path": "./yara_rules",
            "recursive_search": true,
            "fast_match": true,
            "timeout": 60,
            "max_matches": 1000,
            "ignored_tags": ["info", "benign", "fp"]
        },
        "floss": {
            "name": "FLOSS String Analyzer",
            "enabled": true,
            "tool": "floss-3.2.0-linux",
            "min_string_length": 5,
            "timeout": 600
        },
        "quantumstrand": {
            "name": "QUANTUMSTRAND (Beta)",
            "enabled": true,
            "tool": "quantumstrand-beta3-linux",
            "min_string_length": 4,
            "summary_tags": ["#winapi", "#expert", "#decoded"],
            "timeout": 600
        },
        "iocextractor": {
            "name": "IOC Extractor",
            "enabled": true,
            "ignore_tags": ["#winapi", "#code", "#code-junk", "#reloc"],
            "exclude_private_ips": false,
            "defang": false
        }
    }
}
